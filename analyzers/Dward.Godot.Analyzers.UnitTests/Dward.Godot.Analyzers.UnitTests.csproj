<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dward.Godot.Analyzers.UnitTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Overrides the vulnerable Pkcs 9.0.6 pulled in via Analyzer.Testing -> NuGet.Packaging 7.0.3; remove once that chain references a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <ProjectReference Include="..\Dward.Godot.Analyzers\Dward.Godot.Analyzers.csproj" />
    <ProjectReference Include="..\Dward.Godot.Analyzers.CodeFixes\Dward.Godot.Analyzers.CodeFixes.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Dward.Godot.Analyzers\GodotFreeProject.targets"
             Link="GodotFreeProject.targets"
             CopyToOutputDirectory="PreserveNewest" />
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[10.0.0]" />
    <Content Include="$(NuGetPackageRoot)microsoft.netcore.app.ref\10.0.0\ref\net10.0\*.dll"
             Link="ReferenceAssemblies\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
