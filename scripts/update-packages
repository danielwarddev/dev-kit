#!/usr/bin/env bash
set -euo pipefail

root="${1:-"$PWD"}"
[[ -d "$root" ]] || { echo "Project directory not found: $root" >&2; exit 1; }

echo "Scanning for .csproj files under $root"

mapfile -t projects < <(find "$root" -type f -name '*.csproj' \
    -not -path '*/bin/*' -not -path '*/obj/*')

if [[ ${#projects[@]} -eq 0 ]]; then
    echo "No .csproj files found." >&2
    exit 0
fi

failed=()
no_packages_need_updating=2

for project in "${projects[@]}"; do
    echo ""
    echo "=== Updating NuGet packages for $project... ==="

    update_exit_code=0
    dotnet package update --project "$project" || update_exit_code=$?
    if [[ $update_exit_code -ne 0 && $update_exit_code -ne $no_packages_need_updating ]]; then
        failed+=("$project")
        continue
    fi
    if ! dotnet restore "$project"; then
        failed+=("$project: restore")
    fi
done

echo ""
if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Completed with failures:" >&2
    for entry in "${failed[@]}"; do
        echo "  $entry" >&2
    done
    exit 1
fi

echo "All NuGet packages updated to latest stable versions."
